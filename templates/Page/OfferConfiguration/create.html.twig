{% extends 'Layout/BackOffice/base.html.twig' %}

{% block body %}
    <h1 class="sr-only">Configuration d'offre</h1>
    <div class="divide-y divide-white/5">
        <div class="px-4 py-16 sm:px-6 lg:px-8">
            {{ form_start(form) }}
            <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    {{ form_label(form.domain, null, {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.domain, {'attr': {'class': 'block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6 [&_*]:text-black'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.channelId, 'Id du salon Discord', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.channelId, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.minPercentage, 'Pourcentage minimum', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.minPercentage, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.maxPercentage, 'Pourcentage maximum', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.maxPercentage, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.weekAverage, 'Filtre prix moyen sur la semaine', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.weekAverage) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.isPremium, 'Premium', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.isPremium) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.minimumPrice, 'Prix minimum', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.minimumPrice, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.categories, 'Catégories exclues', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.categories, {'attr': {'placeholder': 'Séparez les valeurs par des virgules', 'class': 'block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6'}}) }}
                    </div>
                </div>

            </div>

            <div class="mt-8 flex">
                <button type="submit"
                        class="rounded-md bg-indigo-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">
                    Sauvegarder
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

