{% extends 'Layout/BackOffice/base.html.twig' %}

{% block body %}
    <div class="divide-y divide-white/5">
        <div class="px-4 py-8 sm:px-6 lg:px-8">
            {{ form_start(form) }}
            <div>
                <h2 class="text-base font-semibold leading-7 text-white">Bot Discord</h2>
            </div>
            <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    {{ form_label(form.partner_id, 'Id Amazon du partenaire', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.partner_id, {'attr': {'class': 'block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6 [&_*]:text-black'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.discord_token, 'Token Bot Discord (nécessite un redémarrage du processus Bot Discord)', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.discord_token, {'attr': {'class': 'block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6 [&_*]:text-black'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.minute_interval, 'Interval entre chaque requête (en minutes, nécessite un redémarrage du processus Keepa)', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.minute_interval, {'attr': {'class': 'block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6 [&_*]:text-black'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.keepa_token, 'Token Keepa (nécessite un redémarrage du processus Keepa)', {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.keepa_token, {'attr': {'class': 'block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6 [&_*]:text-black'}}) }}
                    </div>
                </div>
            </div>
            <div class="pt-10">
                <h2 class="text-base font-semibold leading-7 text-white">Filtrage</h2>
            </div>
            <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">

                <div class="sm:col-span-3">
                    {{ form_label(form.min_reviews, "Nombre de commentaire minimum", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.min_reviews, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.min_rating, "Note minimal", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.min_rating, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.min_sales, "Nombre de ventes minimum", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.min_sales, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>
            </div>
            <div class="pt-10">
                <h2 class="text-base font-semibold leading-7 text-white">Avertissement</h2>
            </div>
            <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    {{ form_label(form.review_warning, "Nombre de commentaire minimum", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.review_warning, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.rating_warning, "Note minimal", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.rating_warning, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>
            </div>
            <div class="pt-10">
                <h2 class="text-base font-semibold leading-7 text-white">Id des Emojis</h2>
            </div>
            <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    {{ form_label(form.amazon_emoji_id, "Amazon", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.amazon_emoji_id, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.google_emoji_id, "Google", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.google_emoji_id, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>

                <div class="sm:col-span-3">
                    {{ form_label(form.aliexpress_emoji_id, "Aliexpress", {'label_attr': {'class': 'block text-sm font-medium leading-6 text-white'}}) }}
                    <div class="mt-2">
                        {{ form_widget(form.aliexpress_emoji_id, {'attr': {'class': '"block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6"', 'placeholder': '123456...'}}) }}
                    </div>
                </div>
            </div>

            <div class="mt-8 flex">
                <button type="submit"
                        class="rounded-md bg-indigo-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">
                    Sauvegarder
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock body %}